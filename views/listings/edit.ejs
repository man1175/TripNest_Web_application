<% layout("/layouts/boilerplate") %>

    <body>
        <form action="/listings/<%=listing._id%>?_method=PUT" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">

            <div class="row">
                <div class="col-7 offset-2">
                    <h3 class="mt-3">Edit Listing</h3>
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" name="title" class="form-control" value="<%=listing.title%>" required />
                        <div class="invalid-feedback">Please Enter Valid Title</div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <input type="textarea" class="form-control" name="description"
                            value="<%=listing.description%>" required />
                            <div class="invalid-feedback">Please Enter valid discription</div>
                    </div>

                    
                    
                    
                
                    <div class="mb-3 ">
                        <label for="image" class="form-label">Upload New Image</label>
                        <input type="file" class="form-control" name="image[url]" />
                        
                    </div>

                    <div class="mb-3 ">
                        <label for="image" class="form-label">Original Image</label>
                        <img src="<%= originalImageUrl %>" alt="listing-image">
                    </div>
                
                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" class="form-control" name="location" value="<%=listing.location%>" required />
                        <div class="invalid-feedback">Please Enter Valid Location</div>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-8">
                            <label for="Country" class="form-label">Country</label>
                            <input type="text" class="form-control" name="country" value="<%=listing.country%>" required />
                            <div class="invalid-feedback">Please Enter Valid Country Name</div>
                        </div>

                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input type="number" class="form-control" name="price" step="100"
                                value="<%=listing.price%>" required />
                             <div class="invalid-feedback">Please Enter Price or Enter price in numbers</div>   
                        </div>
                    </div>


                    <button class="btn btn-dark edit-btn">Apply Changes</button><br><br>
                </div>
            </div>
        </form>

    </body>