<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;    
</script>

        <div class="row mt-3">
            <div class="col-8 offset-2">
                <h3> 
                    <%=listing.title%>
                </h3>
            </div>
            <div class="col-8 offset-2">
                <div class="card listing-card">
                    <img src="<%=listing.image.url%>" class="mb-2 card-img-top show-img" alt="listings image">
                    <div class="card-body">
                        <p class="card-text">
                            Posted by:
                            <%= listing.owner ? listing.owner.username : "Unknown User" %>
                        </p>
                        <p class="card-text"> Listing Category : <%= listing.category%> 
                        </p>
                        <p class="card-text"> Description: <%=listing.description%>
                        </p>
                        <p class="card-text"> Location: <%=listing.location%> 
                        </p>
                        <p class="card-text"> Country: <%=listing.country%>
                        </p>
                        <p class="card-text">Price : &#8377 <%=listing.price.toLocaleString("en-IN")%> </p>
                    </div>

                </div>


                <% if(currUser && listing.owner._id.equals(currUser._id)){ %>



                    <div class="row mb-3">
                        <div class="col-2">
                            <form action="/listings/<%=listing._id%>/edit" method="GET">
                                <button class="btn btn-dark edit-btn-show">Edit Details</button>
                            </form>
                        </div>
                        <div class="col-4">

                            <form action="/listings/<%=listing._id%>?_method=DELETE" method="POST">
                                <button class="btn btn-dark">Delete Listing</button>
                            </form>
                        </div>
                        <br>


                    </div>
                    <%}%>
            </div>

            <div class="col-8 offset-2 mb-3">
                <h3>Where you'll be</h3>
                <div id="map">

                </div>
            </div>
            

            <div class="col-8 offset-2 mb-3">
                
                <% if(currUser){ %>
                    <hr>



                    <h5>Leave Your Valuable Review</h5>
                    <form action="/listings/<%=listing._id%>/reviews" method="POST" class="needs-validation" novalidate>
                        
                <fieldset class="starability-growRotate">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>

                        <div class=" mb-3">
                            <label for="comment" class="form-lable">Comment</label>
                            <textarea class="form-control" name="review[comment]" id="comment" cols="30" rows="5"></textarea required>
                        <div class="invalid-feedback">Please enter valid review!</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
                <hr>
            <% } %>  

           


            </div>
            <% if(listing.review.length>0) { %>
            <div class="col-9 offset-2">
                <div class="row">

                    <p> <h5>All Reviews:</h5> </p>
                    <%for(review of listing.review){%>
                        <div class="review-card card col-5 mb-3 ms-3">
                            <div class="card-body">
                                <h5 class="card-title">by : <%=review.author.username %></h5>
                                
                                <p class="starability-result card-text" data-rating="<%=review.rating%>">
                                </p>
                                <p class="card-text"><%=review.comment%></p>

                            <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST" class="mb-2 ms-2">
                            <button class="btn btn-small btn-dark">Delete</button>
                            </form>
                            </div>
                        </div>
                        
                    <%}%>
                </div>
            </div>
            <%}%>
                    
                        
                  
            
           
        </div>

        
<script src="/js/map.js"></script>


